                    },
                    {
                        "@ID": "3",
                        "Name": "Non supported time condition",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
