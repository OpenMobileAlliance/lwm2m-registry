{
    "LWM2M": {
        "@xmlns:xsi": "http://www.w3.org/2001/XMLSchema-instance",
        "@xsi:noNamespaceSchemaLocation": "http://www.openmobilealliance.org/tech/profiles/LWM2M.xsd",
        "Object": {
            "@ObjectType": "MODefinition",
            "Name": "Global Navigation Satellite System",
            "Description1": "More than a positioning object, the uCIFI global navigation satellite system object provides all the information required to calculate a position/location.",
            "ObjectID": "3430",
            "ObjectURN": "urn:oma:lwm2m:ext:3430:2.0",
            "LWM2MVersion": "1.0",
            "ObjectVersion": "2.0",
            "MultipleInstances": "Single",
            "Mandatory": "Optional",
            "Resources": {
                "Item": [
                    {
                        "@ID": "0",
                        "Name": "Fix timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Time",
                        "RangeEnumeration": null,
                        "Units": "s",
                        "Description": "Timestamp of when the location measurement was performed."
                    },
                    {
                        "@ID": "1",
                        "Name": "Latitude",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "lat",
                        "Description": "Decimal notation of latitude, e.g. -43.5723 [World Geodetic System 1984]. This value ranges from [-90, 90]."
                    },
                    {
                        "@ID": "2",
                        "Name": "Longitude",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "lon",
                        "Description": "Decimal notation of longitude, e.g. 153.21760 [World Geodetic System 1984]. This value ranges from [-180, 180]."
                    },
                    {
                        "@ID": "3",
                        "Name": "Altitude",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "m",
                        "Description": "Altitude above mean sea level in meters."
                    },
                    {
                        "@ID": "4",
                        "Name": "Speed",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": "m/s",
                        "Description": "Horizontal speed calculated by the device."
                    },
                    {
                        "@ID": "5",
                        "Name": "Heading",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "deg",
                        "Description": "Direction that the device is following"
                    },
                    {
                        "@ID": "6",
                        "Name": "Radius",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "m",
                        "Description": "Radius of a circular area corresponding to the location\u2019s uncertainty (GPS data precision). Negative values indicate that the radius is not available."
                    },
                    {
                        "@ID": "7",
                        "Name": "HDOP",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Horizontal dilution of precision."
                    },
                    {
                        "@ID": "8",
                        "Name": "VDOP",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Vertical dilution of precision."
                    },
                    {
                        "@ID": "9",
                        "Name": "Estimated horizontal accuracy",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "m",
                        "Description": "Estimated horizontal accuracy."
                    },
                    {
                        "@ID": "10",
                        "Name": "Estimated vertical accuracy",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "m",
                        "Description": "Estimated vertical accuracy."
                    },
                    {
                        "@ID": "11",
                        "Name": "Estimated speed accuracy",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "m/s",
                        "Description": "Estimated speed accuracy."
                    },
                    {
                        "@ID": "12",
                        "Name": "Estimated heading accuracy",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "deg",
                        "Description": "Estimated heading accuracy."
                    },
                    {
                        "@ID": "13",
                        "Name": "Fix type",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Possible values are : \n\t\t\t\t\t0 = No fix\n\t\t\t\t\t1 = Autonomous GNSS fix\n\t\t\t\t\t2 = Differential GNSS fix\n\t\t\t\t\t3 = GPS PPS\n\t\t\t\t\t4 = RTK-fixed\n\t\t\t\t\t5 = RTK-floated\n\t\t\t\t\t6 = Estimated fix\n\t\t\t\t\t7 = Dead reckoning fix\n\t\t\t\t\t8 = Manual input, surveyed\n\t\t\t\t\t9 = Simulated mode\n\t\t\t\t\tIf no fix is possible, but assisted position is provided, value can be returned as 8 = Manual input"
                    },
                    {
                        "@ID": "14",
                        "Name": "Fix dimension",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Possible values are: \n\t\t\t\t\t0,1 = no fix\n\t\t\t\t\t2 = 2D fix\n\t\t\t\t\t3 = 3D fix \n\t\t\t\t\tAs per NMEA-0183 GSA."
                    },
                    {
                        "@ID": "15",
                        "Name": "Used satellites",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Number of satellites used for the fix."
                    },
                    {
                        "@ID": "16",
                        "Name": "Visible satellites",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Number of satellites viewed. Represent all the satellites seen but some of them cannot be in use (e.g. bad signal)."
                    },
                    {
                        "@ID": "17",
                        "Name": "Satellite identifiers",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Identifier of the satellite."
                    },
                    {
                        "@ID": "18",
                        "Name": "Satellite identifiers",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "deg",
                        "Description": "Elevation of the satellite."
                    },
                    {
                        "@ID": "19",
                        "Name": "Satellite azimuth",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "deg",
                        "Description": "Azimuth of the satellite."
                    },
                    {
                        "@ID": "20",
                        "Name": "Almanac",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Validity of the almanac. Possible values are: \n\t\t\t\t\t0 = invalid\n\t\t\t\t\t1 = valid\n\t\t\t\t\t."
                    },
                    {
                        "@ID": "21",
                        "Name": "Ephemeris",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Validity of the ephemeris of each satellite. Possible values are : \n\t\t\t\t\t0 = invalid\n\t\t\t\t\t1 = valid\n\t\t\t\t\t."
                    },
                    {
                        "@ID": "22",
                        "Name": "Signal-to-noise ratio",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "dB",
                        "Description": "Strength of the signal for each satellite, also called carrier-to-noise."
                    },
                    {
                        "@ID": "23",
                        "Name": "GNSS",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "GNSS used for the fix. A mask is used with the following bit definition:\n\t\t\t\t\t0 = GPS (USA)\n\t\t\t\t\t1 = GALILEO (EU)\n\t\t\t\t\t2 = GLONASS (Russia)\n\t\t\t\t\t3 = BeiDou (China)\n\t\t\t\t\t4 = QZSS (Japan)\n\t\t\t\t\t5 = IRNSS/NAVIC (India)\n\t\t\t\t\tA 0 indicates that the GNSS is not used a 1 indicates it is used."
                    },
                    {
                        "@ID": "24",
                        "Name": "Hardware RTC",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Time",
                        "RangeEnumeration": null,
                        "Units": "s",
                        "Description": "Time of the internal clock of the GNSS hardware."
                    },
                    {
                        "@ID": "25",
                        "Name": "Assisted GPS",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Set to True if the almanac is obtained via a cellular connection. Set to False otherwise."
                    },
                    {
                        "@ID": "26",
                        "Name": "Power command",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Command to switch the hardware ON or OFF and status of the device."
                    },
                    {
                        "@ID": "27",
                        "Name": "PDOP",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Dilution of precision (NMEA-0183 GSA)."
                    },
                    {
                        "@ID": "28",
                        "Name": "Status",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Status A=active or V=Void (NMEA-0183 RMC)."
                    },
                    {
                        "@ID": "29",
                        "Name": "Expected latitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "lat",
                        "Description": "Expected latitude configured by the user. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "30",
                        "Name": "Expected longitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "lon",
                        "Description": "Expected longitude configured by the user. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "31",
                        "Name": "Expected altitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "m",
                        "Description": "Expected altitude configured by the user. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "32",
                        "Name": "Expected location threshold",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "m",
                        "Description": "Distance threshold from the expected location beyond which the location changed resource will be set. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "33",
                        "Name": "Out of position",
                        "Type": "Boolean",
                        "Operations": "R",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": null,
                        "Description": "True if the current position is distant more than the configured threshold from the expected location"
                    },
                    {
                        "@ID": "34",
                        "Name": "Assisted latitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "lat",
                        "Description": "Assisted latitude configured by the user, to be used in case of no coverage. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "35",
                        "Name": "Assisted longitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "lon",
                        "Description": "Assisted longitude configured by the user, to be used in case of no coverage. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "36",
                        "Name": "Assisted altitude",
                        "Type": "Float",
                        "Operations": "RW",
                        "Mandatory": "Optional",
                        "MultipleInstances": "Single",
                        "Units": "m",
                        "Description": "Assisted altitude configured by the user, to be used in case of no coverage. Ignored if 0 or NaN"
                    },
                    {
                        "@ID": "5518",
                        "Name": "Timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Time",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The timestamp of when the measurement was performed."
                    },
                    {
                        "@ID": "6050",
                        "Name": "Fractional Timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": "0..1",
                        "Units": "s",
                        "Description": "Fractional part of the timestamp when sub-second precision is used (e.g., 0.23 for 230 ms)."
                    },
                    {
                        "@ID": "6042",
                        "Name": "Measurement Quality Indicator",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": "0..23",
                        "Units": null,
                        "Description": "Measurement quality indicator reported by a smart sensor. 0: UNCHECKED No quality checks were done because they do not exist or can not be applied. 1: REJECTED WITH CERTAINTY The measured value is invalid. 2: REJECTED WITH PROBABILITY The measured value is likely invalid. 3: ACCEPTED BUT SUSPICIOUS The measured value is likely OK. 4: ACCEPTED The measured value is OK. 5-15: Reserved for future extensions. 16-23: Vendor specific measurement quality."
                    },
                    {
                        "@ID": "6049",
                        "Name": "Measurement Quality Level",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": "0..100",
                        "Units": null,
                        "Description": "Measurement quality level reported by a smart sensor. Quality level 100 means that the measurement has fully passed quality check algorithms. Smaller quality levels mean that quality has decreased and the measurement has only partially passed quality check algorithms. The smaller the quality level, the more caution should be used by the application when using the measurement. When the quality level is 0 it means that the measurement should certainly be rejected."
                    }
                ]
            },
            "Description2": null
        }
    }
}