{
    "LWM2M": {
        "@xmlns:xsi": "http://www.w3.org/2001/XMLSchema-instance",
        "@xsi:noNamespaceSchemaLocation": "http://www.openmobilealliance.org/tech/profiles/LWM2M.xsd",
        "Object": {
            "@ObjectType": "MODefinition",
            "Name": "LPWAN Mesh Connectivity",
            "Description1": "The uCIFI LPWAN Mesh Connectivity object enables monitoring and management of parameters related with the operation of 802.15.4-based LPWAN devices.",
            "ObjectID": "3447",
            "ObjectURN": "urn:oma:lwm2m:ext:3447",
            "LWM2MVersion": "1.0",
            "ObjectVersion": "1.0",
            "MultipleInstances": "Single",
            "Mandatory": "Optional",
            "Resources": {
                "Item": [
                    {
                        "@ID": "0",
                        "Name": "Network Type",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Provides information on the type or set of specifications on which the mesh Connectivity is based. This information is encoded as string to provide flexibility in the adoption of future mesh technologies. Examples: \"802.15.4 proprietary\", \"Zigbee\", \"Bluetooth 5.0 Mesh\", \"Thread\", \"80215.4 6LowPAN\", \"Wi-SUN\"."
                    },
                    {
                        "@ID": "1",
                        "Name": "Device class",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "0: End-Device, 1: Router, 2: Repeater, 3: Border Router, 4: Bridge, 5: Gateway."
                    },
                    {
                        "@ID": "2",
                        "Name": "Operating Frequency",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "MHz",
                        "Description": "Frequency of the wireless communication used on the LPWAN network. Set as a Read-Writable attribute for those scenarios where the Radio can be configured to operate in different frequencies."
                    },
                    {
                        "@ID": "3",
                        "Name": "Status",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "0: Disabled, 1: Connecting, 2: Connected, 3: Disconnecting, 4: Disconnected."
                    },
                    {
                        "@ID": "4",
                        "Name": "Connection Errors",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Display\u2019s information on current errors affecting mesh connectivity."
                    },
                    {
                        "@ID": "5",
                        "Name": "Last Error timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Time",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Represented in UTC."
                    },
                    {
                        "@ID": "6",
                        "Name": "Error Counter",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Cumulative counter reporting on total observed errors."
                    },
                    {
                        "@ID": "7",
                        "Name": "Error Counter Reset",
                        "Operations": "E",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": null,
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Resets \"Error Counter\" to zero."
                    },
                    {
                        "@ID": "8",
                        "Name": "Transmit Power",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "dBm",
                        "Description": "Transmit power used by the IoT device on the LPWAN network."
                    },
                    {
                        "@ID": "9",
                        "Name": "Data Rate",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "bit/s",
                        "Description": "Data rate of the communication used on the LPWAN network."
                    },
                    {
                        "@ID": "10",
                        "Name": "Operation Mode",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Provides information on what mode of operation is in effect. The meaning of which is technology dependent."
                    },
                    {
                        "@ID": "11",
                        "Name": "Operating Channel",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The current channel used for the transfer of data frames. The LwM2M client may update this field to reflect changes in frequency if a frequency hopping mechanism is in use."
                    },
                    {
                        "@ID": "12",
                        "Name": "Channel Hopping Function",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The current Frequency hopping function in use by the device: 0: disabled, 1: Pseudo-Random, 2: Adaptative."
                    },
                    {
                        "@ID": "13",
                        "Name": "Available Channels",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Array of supported radio channels within the Regulatory Domain."
                    },
                    {
                        "@ID": "14",
                        "Name": "Unicast Channel Plan",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Defined for those technologies that make use of a specific subset of channels for Unicast Datagram transmission."
                    },
                    {
                        "@ID": "15",
                        "Name": "Broadcast Channel Plan",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Defined for those technologies that make use of a specific subset of channels for Broadcast Datagram transmission."
                    },
                    {
                        "@ID": "16",
                        "Name": "FEC",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Forward Error Correction may be enabled to improve datagram in noisy network conditions : 0: Disabled, 1: Enabled."
                    },
                    {
                        "@ID": "17",
                        "Name": "Data Whitening",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Boolean",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Data whitening may be enabled to ensure smother power distribution over the occupied bandwidth and improve the quality of the RF link : 0: Disabled, 1: Enabled."
                    },
                    {
                        "@ID": "18",
                        "Name": "Cipher Suite",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Cipher suite string identifying the authentication and encryption algorithms used in mesh security. i.e:  TLS_ECDHE_ECDSA_WITH_AES_128_CCM."
                    },
                    {
                        "@ID": "19",
                        "Name": "PAN Identifier",
                        "Operations": "RW",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The 802.15.4 PAN ID used within the network."
                    },
                    {
                        "@ID": "20",
                        "Name": "Network Name",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "An operator defined network ID associated with the mesh cluster."
                    },
                    {
                        "@ID": "21",
                        "Name": "Node Rank",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The hierarchy of the mesh router/end-device within the network. It may be expressed as the number of hops between the node and the Border Router/gateway or as the computed cost of the path connecting the node to the Border-Router/gateway."
                    },
                    {
                        "@ID": "22",
                        "Name": "Root Address",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Address or identifier of the Border Router/ Gateway node providing connectivity outside the mesh cluster."
                    },
                    {
                        "@ID": "23",
                        "Name": "Parent Address",
                        "Operations": "R",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Address or identifier of the node selected as the next hop on the optimal path towards the mesh Root."
                    },
                    {
                        "@ID": "24",
                        "Name": "Physical interface",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Mandatory",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The MAC address of the interface, in hexadecimal form."
                    },
                    {
                        "@ID": "25",
                        "Name": "Logical Address",
                        "Operations": "RW",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The IP addresses assigned to the connectivity interface. (e.g. IPv4, IPv6, etc.)."
                    },
                    {
                        "@ID": "26",
                        "Name": "IP Address",
                        "Operations": "RW",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The IP addresses assigned to the connectivity interface. (e.g. IPv4, IPv6, etc.)."
                    },
                    {
                        "@ID": "27",
                        "Name": "Multicast Group Address",
                        "Operations": "RW",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "String",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Group address from which the IoT device should accept incoming messages and/or commands."
                    },
                    {
                        "@ID": "28",
                        "Name": "Multicast group key",
                        "Operations": "RW",
                        "MultipleInstances": "Multiple",
                        "Mandatory": "Optional",
                        "Type": "Opaque",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Security key (e.g. AES128) to be shared with other members to be part of a multicast group. The opaque format enables to support non printable characters."
                    },
                    {
                        "@ID": "29",
                        "Name": "Signal to noise ratio",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "dB",
                        "Description": "Ratio of signal power to the noise power ."
                    },
                    {
                        "@ID": "30",
                        "Name": "Received Signal Strength Indication",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "dBm",
                        "Description": "Signal strength of the communication network measured by the device (a.k.a. RSSI)."
                    },
                    {
                        "@ID": "31",
                        "Name": "Noise Floor",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": null,
                        "Units": "dBm",
                        "Description": "Noise Floor of the communication network measured by the device."
                    },
                    {
                        "@ID": "34",
                        "Name": "Maximum repeat time",
                        "Operations": "RW",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "Maximum number of times a message should be repeated within a mesh network (e.g. number of CoAP retransmissions)"
                    },
                    {
                        "@ID": "5518",
                        "Name": "Timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Time",
                        "RangeEnumeration": null,
                        "Units": null,
                        "Description": "The timestamp of when the measurement was performed."
                    },
                    {
                        "@ID": "6050",
                        "Name": "Fractional Timestamp",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Float",
                        "RangeEnumeration": "0..1",
                        "Units": "s",
                        "Description": "Fractional part of the timestamp when sub-second precision is used (e.g., 0.23 for 230 ms)."
                    },
                    {
                        "@ID": "6042",
                        "Name": "Measurement Quality Indicator",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": "0..23",
                        "Units": null,
                        "Description": "Measurement quality indicator reported by a smart sensor. 0: UNCHECKED No quality checks were done because they do not exist or can not be applied. 1: REJECTED WITH CERTAINTY The measured value is invalid. 2: REJECTED WITH PROBABILITY The measured value is likely invalid. 3: ACCEPTED BUT SUSPICIOUS The measured value is likely OK. 4: ACCEPTED The measured value is OK. 5-15: Reserved for future extensions. 16-23: Vendor specific measurement quality."
                    },
                    {
                        "@ID": "6049",
                        "Name": "Measurement Quality Level",
                        "Operations": "R",
                        "MultipleInstances": "Single",
                        "Mandatory": "Optional",
                        "Type": "Integer",
                        "RangeEnumeration": "0..100",
                        "Units": null,
                        "Description": "Measurement quality level reported by a smart sensor. Quality level 100 means that the measurement has fully passed quality check algorithms. Smaller quality levels mean that quality has decreased and the measurement has only partially passed quality check algorithms. The smaller the quality level, the more caution should be used by the application when using the measurement. When the quality level is 0 it means that the measurement should certainly be rejected."
                    }
                ]
            },
            "Description2": null
        }
    }
}